# Copy to .env and change the secrets for anything beyond a local demo. Never commit .env.

# Gateway (Nginx) port on the host
GATEWAY_PORT=8080
# Number of backend replicas behind the Nginx load balancer
BACKEND_REPLICAS=2

# PostgreSQL
POSTGRES_USER=fraudshield
POSTGRES_PASSWORD=fraudshield
POSTGRES_DB=fraudshield

# Service API key the simulated card gateway sends as X-API-Key to POST /api/v1/authorisations
GATEWAY_API_KEY=dev-gateway-key-change-me
# Secret used to sign user JWTs
JWT_SECRET=dev-jwt-secret-change-me
# Salt for the stored SHA-256 hash of card numbers (only hash + last 4 digits are stored)
CARD_HASH_SALT=dev-card-salt-change-me

# Demo conveniences: role selector on the login page, login-free /simulator, demo reset, "expire now" button
DEMO_MODE=true
# Password for every seeded demo account (staff and cardholders)
DEMO_PASSWORD=Demo@123
# Allow managers to run the automated test categories from the UI (uses a separate test database)
ENABLE_TEST_RUNNER=true

LOG_LEVEL=info
